---
---
<header class="nav">
  <div class="wrap nav__inner">
    <a href="/" class="nav__logo">Studio&nbsp;<span>&amp;</span>&nbsp;MW</a>
    <nav class="nav__links">
      <a href={`${import.meta.env.BASE_URL}/obra`}>Obra</a>
      <a href={`${import.meta.env.BASE_URL}/revista`}>Revista</a>
      <a href="/#estudio">Estudio</a>
      <a href="/#contacto" class="nav__cta">Contacto</a>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(246, 244, 238, 0.86);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 76px;
  }
  .nav__logo {
    font-family: var(--font-display);
    font-size: 22px;
    letter-spacing: 0.01em;
  }
  .nav__logo span { color: var(--moss); font-style: italic; }
  .nav__links {
    display: flex;
    align-items: center;
    gap: 28px;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .nav__links a { padding: 6px 0; border-bottom: 1px solid transparent; }
  .nav__links a:hover { border-bottom-color: var(--ink); }
  .nav__cta {
    border: 1px solid var(--ink) !important;
    padding: 8px 16px !important;
    border-radius: 999px;
  }
  .nav__cta:hover { background: var(--ink); color: var(--paper); }

  @media (max-width: 640px) {
    .nav__links { gap: 14px; font-size: 11px; }
    .nav__cta { padding: 6px 10px !important; }
  }
</style>

---
---
<footer class="footer" id="contacto">
  <div class="wrap footer__inner">
    <div class="footer__col">
      <h3 class="footer__title">Hablemos de tu proyecto</h3>
      <a href="mailto:hola@piedraluz.studio" class="footer__email">hola@piedraluz.studio</a>
    </div>
    <div class="footer__col footer__meta">
      <p class="eyebrow">Estudio</p>
      <p>Santiago, Chile</p>
      <p>+56 9 0000 0000</p>
    </div>
    <div class="footer__col footer__meta">
      <p class="eyebrow">Síguenos</p>
      <p><a href="#">Instagram</a></p>
      <p><a href="#">LinkedIn</a></p>
    </div>
  </div>
  <div class="wrap footer__bottom">
    <span>© {new Date().getFullYear()} Piedra & Luz</span>
    <span>Hecho con Astro</span>
  </div>
</footer>

<style>
  .footer {
    background: var(--night);
    color: var(--paper);
    padding: 80px 0 24px;
    margin-top: 120px;
  }
  .footer__inner {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 40px;
    padding-bottom: 60px;
    border-bottom: 1px solid rgba(246,244,238,0.15);
  }
  .footer__title {
    font-size: clamp(28px, 4vw, 40px);
    margin-bottom: 20px;
    max-width: 10ch;
  }
  .footer__email {
    font-family: var(--font-mono);
    font-size: 15px;
    border-bottom: 1px solid var(--moss-soft);
    padding-bottom: 2px;
  }
  .footer__meta p { margin: 6px 0; color: var(--stone); font-size: 14px; }
  .footer__meta a:hover { color: var(--paper); }
  .footer__bottom {
    display: flex;
    justify-content: space-between;
    padding-top: 24px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--stone);
  }
  @media (max-width: 700px) {
    .footer__inner { grid-template-columns: 1fr; gap: 28px; }
  }
</style>

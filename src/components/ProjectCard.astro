---
interface Props {
  href: string;
  imagen: string;
  imagenAlt: string;
  titulo: string;
  ubicacion: string;
  anio: number;
  size?: 'lg' | 'md';
}
const { href, imagen, imagenAlt, titulo, ubicacion, anio, size = 'md' } = Astro.props;
---
<a href={href} class={`card card--${size} reveal`}>
  <div class="card__frame">
    <img src={imagen} alt={imagenAlt} loading="lazy" />
  </div>
  <div class="card__meta">
    <h3 class="card__title">{titulo}</h3>
    <p class="card__sub">{ubicacion} — {anio}</p>
  </div>
</a>

<style>
  .card { display: block; }
  .card__frame {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--paper-dim);
  }
  .card__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .card:hover .card__frame img { transform: scale(1.045); }
  .card__meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    margin-top: 14px;
  }
  .card__title {
    font-size: 19px;
    font-style: italic;
  }
  .card__sub {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--stone);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0;
    white-space: nowrap;
  }
</style>

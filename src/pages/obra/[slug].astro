---
import Layout from '../../layouts/Layout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const proyectos = await getCollection('proyectos');
  return proyectos.map((p) => ({
    params: { slug: p.slug },
    props: { proyecto: p },
  }));
}

interface Props {
  proyecto: CollectionEntry<'proyectos'>;
}

const { proyecto } = Astro.props;
const { Content } = await proyecto.render();
const { titulo, ubicacion, anio, categoria, imagen, imagenAlt, resumen } = proyecto.data;
---
<Layout title={titulo} description={resumen}>
  <article>
    <header class="phero">
      <img class="phero__img" src={imagen} alt={imagenAlt} />
      <div class="phero__scrim"></div>
      <div class="wrap phero__content">
        <p class="eyebrow phero__eyebrow">{categoria}</p>
        <h1 class="phero__title">{titulo}</h1>
        <p class="phero__meta">{ubicacion} — {anio}</p>
      </div>
    </header>

    <div class="wrap body">
      <div class="body__inner reveal">
        <Content />
      </div>
    </div>

    <div class="wrap back">
      <a href="/obra" class="back__link">← Volver a Obra</a>
    </div>
  </article>
</Layout>

<style>
  .phero { position: relative; height: 70vh; min-height: 420px; overflow: hidden; }
  .phero__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .phero__scrim {
    position: absolute; inset: 0;
    background: linear-gradient(0deg, rgba(11,11,9,0.65) 0%, transparent 60%);
  }
  .phero__content { position: absolute; left: 0; right: 0; bottom: 44px; }
  .phero__eyebrow { color: #E4E1D6; margin-bottom: 10px; }
  .phero__title { color: #FAF9F4; font-size: clamp(34px, 6vw, 64px); max-width: 18ch; }
  .phero__meta {
    color: var(--stone);
    font-family: var(--font-mono);
    font-size: 13px;
    text-transform: uppercase;
    margin-top: 12px;
  }
  .body { padding: 72px 0; }
  .body__inner {
    max-width: 68ch;
    font-size: 19px;
    line-height: 1.75;
    color: var(--ink-soft);
  }
  .body__inner :global(h2) {
    font-size: 28px;
    color: var(--ink);
    margin-top: 48px;
    margin-bottom: 16px;
  }
  .back { padding-bottom: 100px; }
  .back__link {
    font-family: var(--font-mono);
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 2px;
  }
</style>

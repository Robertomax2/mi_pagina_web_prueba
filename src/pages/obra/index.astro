---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const proyectos = (await getCollection('proyectos')).sort((a, b) => b.data.anio - a.data.anio);
---
<Layout title="Obra" description="Todos los proyectos de Piedra & Luz.">
  <section class="wrap head">
    <p class="eyebrow reveal">Obra</p>
    <h1 class="reveal">Proyectos construidos entre el paisaje y la piedra.</h1>
  </section>

  <section class="wrap grid">
    {proyectos.map((p) => (
      <ProjectCard
        href={`/obra/${p.slug}`}
        imagen={p.data.imagen}
        imagenAlt={p.data.imagenAlt}
        titulo={p.data.titulo}
        ubicacion={p.data.ubicacion}
        anio={p.data.anio}
      />
    ))}
  </section>
</Layout>

<style>
  .head { padding: 72px 0 56px; border-bottom: 1px solid var(--line); }
  .head h1 { font-size: clamp(34px, 5vw, 58px); max-width: 16ch; margin-top: 16px; }
  .grid {
    padding: 64px 0 120px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 48px 28px;
  }
  @media (max-width: 900px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
